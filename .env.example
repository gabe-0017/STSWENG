# Copy to .env (never commit .env) or set these in Render / GitHub Actions secrets.
# Local dev works without any of these: application-dev.properties has safe local defaults.

# Spring profile: dev (local) | staging (Render)
SPRING_PROFILES_ACTIVE=dev

# Database (Neon connection for staging: direct host, sslmode=require, no channel_binding)
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/civiccare
SPRING_DATASOURCE_USERNAME=civiccare
SPRING_DATASOURCE_PASSWORD=change-me

# Secrets: at least 32 random characters each. Generate with: openssl rand -base64 48
JWT_SIGNING_KEY=change-me-to-a-long-random-value-at-least-32-chars
ID_HMAC_SECRET=change-me-to-a-different-long-random-value-32-chars

# Only needed when the frontend runs on a different origin than the API (e.g. the Vite dev server
# without its proxy). In staging the frontend is served by this same service, so this is optional;
# if login ever fails with "Invalid CORS request", set it to your own service URL (no trailing slash).
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Synthetic demo accounts (lgu@, establishment@, admin@, senior@civiccare.test)
DEMO_DATA_ENABLED=true
DEMO_PASSWORD=change-me

# Later sprints
# QR_TOKEN_SIGNING_KEY=
# CHAIN_RPC_URL=
# CHAIN_CONTRACT_ADDRESS=
# CHAIN_ISSUER_PRIVATE_KEY=
