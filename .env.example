# Copy to .env (never commit .env) or set these in Render's environment settings.
# Local dev works without any of these: application-dev.properties has safe local defaults.

# Spring profile: dev (local) | staging (Render)
SPRING_PROFILES_ACTIVE=dev

# Database
# Local (docker compose): jdbc:postgresql://localhost:5432/civiccare
#   (from inside a container use host.docker.internal instead of localhost)
# Supabase: use the Session pooler string, NOT the direct connection (Render cannot reach it):
#   SPRING_DATASOURCE_URL=jdbc:postgresql://aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
#   SPRING_DATASOURCE_USERNAME=postgres.<project-ref>
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/civiccare
SPRING_DATASOURCE_USERNAME=civiccare
SPRING_DATASOURCE_PASSWORD=change-me

# Secrets: at least 32 random characters each. Generate with: openssl rand -base64 48
# (render.yaml generates these automatically on Render)
JWT_SIGNING_KEY=change-me-to-a-long-random-value-at-least-32-chars
ID_HMAC_SECRET=change-me-to-a-different-long-random-value-32-chars

# Only needed when the frontend runs on a different URL than the API.
# On Render the site and API share one URL, so this can be left out there.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Synthetic demo accounts (lgu@, establishment@, admin@, senior@civiccare.test)
DEMO_DATA_ENABLED=true
DEMO_PASSWORD=change-me

# Later sprints
# QR_TOKEN_SIGNING_KEY=
# CHAIN_RPC_URL=
# CHAIN_CONTRACT_ADDRESS=
# CHAIN_ISSUER_PRIVATE_KEY=
