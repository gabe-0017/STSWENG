# Copy to .env (never commit .env) or set these in Render / GitHub Actions secrets.
# Local dev works without any of these: application-dev.properties has safe local defaults.

# Spring profile: dev (local) | staging (Render)
SPRING_PROFILES_ACTIVE=dev

# Database (Neon / Supabase connection string for staging)
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/seniorchain
SPRING_DATASOURCE_USERNAME=seniorchain
SPRING_DATASOURCE_PASSWORD=change-me

# Secrets: at least 32 random characters each. Generate with: openssl rand -base64 48
JWT_SIGNING_KEY=change-me-to-a-long-random-value-at-least-32-chars
ID_HMAC_SECRET=change-me-to-a-different-long-random-value-32-chars

# Frontend URL(s), comma-separated
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Synthetic demo accounts (lgu@, establishment@, admin@, senior@seniorchain.test)
DEMO_DATA_ENABLED=true
DEMO_PASSWORD=change-me

# Later sprints
# QR_TOKEN_SIGNING_KEY=
# CHAIN_RPC_URL=
# CHAIN_CONTRACT_ADDRESS=
# CHAIN_ISSUER_PRIVATE_KEY=
